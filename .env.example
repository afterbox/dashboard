# Copy to .env.local and fill in. Never commit .env.local, and never print these values.

# Supabase Postgres (the connection string, as the database owner).
# Use the "Session pooler" string from Supabase's Connect panel: the direct one only works over IPv6.
DATABASE_URL=

# Supabase project URL and the secret key (sb_secret_..., not the legacy service role key). Server only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Better Auth: a long random secret (openssl rand -base64 32) and the app's own address
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Resend, for the sign-in code email
RESEND_API_KEY=

# Optional. The address sign-in codes come from once the domain is verified in Resend.
# Development always sends from onboarding@resend.dev.
EMAIL_FROM=

# Optional. Google sign-in switches on when both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional, for later: open banking
TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=
TRUELAYER_ENV=

# Test only. Playwright sets this itself (playwright.config.ts); leave it out everywhere else.
# The app refuses to start with it in production.
# E2E_TEST_MODE=
